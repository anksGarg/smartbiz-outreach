ANTHROPIC_API_KEY=your_anthropic_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@yourdomain.com
BREVO_FROM_NAME=Willamette Power Roofing
GOOGLE_SOLAR_API_KEY=your_google_solar_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here
BATCHDATA_API_KEY=your_batchdata_api_key_here
# QR code base URL — set to your Render URL in production, omit locally to use the Render default
# BASE_URL=https://smartbiz-outreach.onrender.com
# Separate Google Sheet for the Follow-up module's saved customer list — must be its
# own Sheet per environment (dev vs prod), never GOOGLE_SHEET_ID or any literal ID.
CUSTOMERS_SHEET_ID=
CUSTOMERS_SHEET_LABEL=
# Explicit production override: set to exactly "true" to allow live sending
# (follow-up and custom email) before a real mailing address is configured.
# Unset (default) behaves exactly as before — leave empty unless you mean it.
FOLLOWUP_ALLOW_LIVE_WITHOUT_ADDRESS=
